int gas = 0;
void setup() {
  Serial.begin(9600);
  pinMode(A0, INPUT);
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);

}

void loop() {
  gas = analogRead(A0);
  Serial.println(gas);
  bool Ledstate = gas_state();
  digitalWrite(3, Ledstate);
  digitalWrite(4, !Ledstate);
  if (!Ledstate) Buzzer();
  noTone(2);
}


boolean gas_state() {
  return (gas < 600);
}

void Buzzer() {
  tone(2, 1000);
  Serial.println("Alchol a niveles anormales");
  delay(5000);
}
